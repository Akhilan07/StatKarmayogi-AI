# MoSPI StatKarmayogi Engine Environment Configuration

# Server Environment & Port Configuration
PORT=3000
NODE_ENV=production

# Server-Side API Secrets (NEVER expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
SESSION_SECRET=a_very_secure_random_session_secret_32_chars_long
JWT_SECRET=a_cryptographically_secure_jwt_secret_key_2026
ENCRYPTION_KEY=a_32_byte_aes_256_gcm_secret_key_statkarmayogi_2026

# CORS Allowed Origins (Comma-separated URLs for production & local dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://statkarmayogi.gov.in

# Production Security Options
FORCE_HTTPS=true
COOKIE_DOMAIN=statkarmayogi.gov.in

# Frontend Base URL
VITE_BACKEND_URL=http://localhost:3000
